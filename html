<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Gerador de Senhas</title>
    <style>
        /* Reset básico e estilos gerais */
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: linear-gradient(135deg, #0f0c29, #302b63, #24243e);
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 20px;
        }

        .container {
            background: rgba(255, 255, 255, 0.08);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border-radius: 24px;
            padding: 40px 35px;
            max-width: 520px;
            width: 100%;
            box-shadow: 0 25px 50px rgba(0, 0, 0, 0.5);
            border: 1px solid rgba(255, 255, 255, 0.15);
            transition: transform 0.3s ease;
        }

        h1 {
            color: #fff;
            font-weight: 600;
            font-size: 2rem;
            text-align: center;
            margin-bottom: 8px;
            letter-spacing: 1px;
        }

        .subtitle {
            color: rgba(255, 255, 255, 0.6);
            text-align: center;
            font-size: 0.95rem;
            margin-bottom: 30px;
            border-bottom: 1px solid rgba(255, 255, 255, 0.1);
            padding-bottom: 16px;
        }

        /* Campo da senha */
        .password-display {
            background: rgba(0, 0, 0, 0.4);
            border-radius: 14px;
            padding: 16px 20px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 25px;
            border: 1px solid rgba(255, 255, 255, 0.1);
            transition: border 0.2s;
        }

        .password-display:hover {
            border-color: rgba(255, 255, 255, 0.3);
        }

        #senhaOutput {
            font-family: 'Courier New', monospace;
            font-size: 1.5rem;
            font-weight: 600;
            color: #a7e0ff;
            word-break: break-all;
            letter-spacing: 1px;
            background: transparent;
            border: none;
            outline: none;
            width: 100%;
            padding-right: 10px;
        }

        #senhaOutput::selection {
            background: #6c5ce7;
            color: #fff;
        }

        .btn-copiar {
            background: rgba(255, 255, 255, 0.08);
            border: none;
            color: #ccc;
            width: 42px;
            height: 42px;
            border-radius: 50%;
            cursor: pointer;
            font-size: 1.2rem;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: all 0.2s;
            flex-shrink: 0;
        }

        .btn-copiar:hover {
            background: rgba(108, 92, 231, 0.4);
            color: #fff;
            transform: scale(1.05);
        }

        .btn-copiar.copiado {
            background: #00b894;
            color: #fff;
        }

        /* Controles */
        .controles {
            display: flex;
            flex-direction: column;
            gap: 22px;
            margin-bottom: 28px;
        }

        .grupo {
            display: flex;
            align-items: center;
            justify-content: space-between;
            color: rgba(255, 255, 255, 0.85);
            font-weight: 500;
        }

        .grupo label {
            font-size: 1rem;
        }

        .grupo input[type="number"] {
            width: 75px;
            padding: 10px 12px;
            border-radius: 10px;
            border: 1px solid rgba(255, 255, 255, 0.2);
            background: rgba(0, 0, 0, 0.3);
            color: #fff;
            font-size: 1.1rem;
            text-align: center;
            font-weight: 600;
            transition: border 0.2s;
        }

        .grupo input[type="number"]:focus {
            border-color: #6c5ce7;
            outline: none;
        }

        .grupo input[type="number"]::-webkit-inner-spin-button {
            opacity: 0.5;
        }

        .range-wrapper {
            display: flex;
            align-items: center;
            gap: 14px;
            flex: 1;
            margin-left: 15px;
        }

        .range-wrapper input[type="range"] {
            flex: 1;
            -webkit-appearance: none;
            appearance: none;
            height: 5px;
            border-radius: 5px;
            background: rgba(255, 255, 255, 0.15);
            outline: none;
            transition: background 0.2s;
        }

        .range-wrapper input[type="range"]::-webkit-slider-thumb {
            -webkit-appearance: none;
            appearance: none;
            width: 20px;
            height: 20px;
            border-radius: 50%;
            background: #6c5ce7;
            cursor: pointer;
            box-shadow: 0 0 10px rgba(108, 92, 231, 0.5);
            transition: 0.1s;
        }

        .range-wrapper input[type="range"]::-webkit-slider-thumb:hover {
            transform: scale(1.1);
        }

        .range-wrapper input[type="range"]::-moz-range-thumb {
            width: 20px;
            height: 20px;
            border-radius: 50%;
            background: #6c5ce7;
            cursor: pointer;
            border: none;
        }

        .range-value {
            min-width: 30px;
            text-align: center;
            font-weight: 700;
            color: #a7e0ff;
            font-size: 1.1rem;
        }

        /* Checkbox opcionais */
        .opcoes {
            display: flex;
            gap: 20px;
            flex-wrap: wrap;
            color: rgba(255, 255, 255, 0.8);
            font-size: 0.95rem;
        }

        .opcoes label {
            display: flex;
            align-items: center;
            gap: 8px;
            cursor: pointer;
        }

        .opcoes input[type="checkbox"] {
            width: 18px;
            height: 18px;
            accent-color: #6c5ce7;
            cursor: pointer;
        }

        /* Botão gerar */
        .btn-gerar {
            width: 100%;
            padding: 16px;
            background: linear-gradient(135deg, #6c5ce7, #a29bfe);
            border: none;
            border-radius: 14px;
            color: #fff;
            font-size: 1.2rem;
            font-weight: 700;
            cursor: pointer;
            transition: all 0.3s;
            letter-spacing: 1px;
            box-shadow: 0 8px 20px rgba(108, 92, 231, 0.3);
            margin-top: 5px;
        }

        .btn-gerar:hover {
            transform: translateY(-3px);
            box-shadow: 0 12px 28px rgba(108, 92, 231, 0.5);
            background: linear-gradient(135deg, #5f4dd0, #8f7cf0);
        }

        .btn-gerar:active {
            transform: scale(0.97);
        }

        /* Notificação de copiado */
        .toast {
            position: fixed;
            bottom: 30px;
            left: 50%;
            transform: translateX(-50%) translateY(100px);
            background: rgba(0, 0, 0, 0.8);
            backdrop-filter: blur(8px);
            color: #fff;
            padding: 14px 30px;
            border-radius: 40px;
            font-weight: 500;
            font-size: 1rem;
            opacity: 0;
            transition: all 0.4s ease;
            pointer-events: none;
            border: 1px solid rgba(255, 255, 255, 0.1);
        }

        .toast.show {
            opacity: 1;
            transform: translateX(-50%) translateY(0);
        }

        /* Responsividade */
        @media (max-width: 480px) {
            .container {
                padding: 25px 20px;
            }
            h1 {
                font-size: 1.6rem;
            }
            #senhaOutput {
                font-size: 1.2rem;
            }
            .grupo {
                flex-wrap: wrap;
                gap: 10px;
            }
            .range-wrapper {
                margin-left: 0;
                width: 100%;
            }
            .opcoes {
                justify-content: center;
            }
        }
    </style>
</head>
<body>
    <div class="container">
        <h1>🔐 Gerador de Senhas</h1>
        <p class="subtitle">Crie senhas fortes e seguras</p>

        <!-- Campo de exibição -->
        <div class="password-display">
            <input type="text" id="senhaOutput" readonly placeholder="Clique em gerar" value="">
            <button class="btn-copiar" id="btnCopiar" title="Copiar senha">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
                    <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
                </svg>
            </button>
        </div>

        <!-- Controles -->
        <div class="controles">
            <div class="grupo">
                <label for="tamanhoInput">Comprimento</label>
                <div class="range-wrapper">
                    <input type="range" id="tamanhoRange" min="4" max="50" value="16">
                    <input type="number" id="tamanhoInput" min="4" max="50" value="16">
                    <span class="range-value" id="rangeValue">16</span>
                </div>
            </div>

            <div class="opcoes">
                <label>
                    <input type="checkbox" id="incluirMaiusculas" checked>
                    Maiúsculas (A-Z)
                </label>
                <label>
                    <input type="checkbox" id="incluirMinusculas" checked>
                    Minúsculas (a-z)
                </label>
                <label>
                    <input type="checkbox" id="incluirNumeros" checked>
                    Números (0-9)
                </label>
                <label>
                    <input type="checkbox" id="incluirEspeciais">
                    Especiais (!@#$%&*)
                </label>
            </div>
        </div>

        <button class="btn-gerar" id="btnGerar">⚡ Gerar Senha</button>
    </div>

    <!-- Toast de notificação -->
    <div class="toast" id="toast">📋 Senha copiada!</div>

    <script>
        (function() {
            // Elementos
            const senhaOutput = document.getElementById('senhaOutput');
            const btnGerar = document.getElementById('btnGerar');
            const btnCopiar = document.getElementById('btnCopiar');
            const tamanhoRange = document.getElementById('tamanhoRange');
            const tamanhoInput = document.getElementById('tamanhoInput');
            const rangeValue = document.getElementById('rangeValue');
            const incluirMaiusculas = document.getElementById('incluirMaiusculas');
            const incluirMinusculas = document.getElementById('incluirMinusculas');
            const incluirNumeros = document.getElementById('incluirNumeros');
            const incluirEspeciais = document.getElementById('incluirEspeciais');
            const toast = document.getElementById('toast');

            // Sincronizar range e input number
            function sincronizarTamanho(valor) {
                const num = parseInt(valor, 10);
                if (isNaN(num)) return;
                const clamp = Math.min(50, Math.max(4, num));
                tamanhoRange.value = clamp;
                tamanhoInput.value = clamp;
                rangeValue.textContent = clamp;
            }

            tamanhoRange.addEventListener('input', function() {
                sincronizarTamanho(this.value);
            });

            tamanhoInput.addEventListener('input', function() {
                let val = parseInt(this.value, 10);
                if (isNaN(val)) return;
                val = Math.min(50, Math.max(4, val));
                sincronizarTamanho(val);
            });

            tamanhoInput.addEventListener('blur', function() {
                let val = parseInt(this.value, 10);
                if (isNaN(val) || val < 4) val = 4;
                if (val > 50) val = 50;
                sincronizarTamanho(val);
            });

            // Função para gerar senha
            function gerarSenha() {
                const tamanho = parseInt(tamanhoRange.value, 10);
                if (isNaN(tamanho) || tamanho < 4) {
                    senhaOutput.value = 'Erro: tamanho inválido';
                    return;
                }

                const usarMaiusculas = incluirMaiusculas.checked;
                const usarMinusculas = incluirMinusculas.checked;
                const usarNumeros = incluirNumeros.checked;
                const usarEspeciais = incluirEspeciais.checked;

                // Pelo menos uma opção deve estar marcada
                if (!usarMaiusculas && !usarMinusculas && !usarNumeros && !usarEspeciais) {
                    senhaOutput.value = 'Selecione pelo menos um tipo de caractere';
                    return;
                }

                // Conjuntos de caracteres
                const maiusculas = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ';
                const minusculas = 'abcdefghijklmnopqrstuvwxyz';
                const numeros = '0123456789';
                const especiais = '!@#$%&*';

                let caracteresPermitidos = '';
                if (usarMaiusculas) caracteresPermitidos += maiusculas;
                if (usarMinusculas) caracteresPermitidos += minusculas;
                if (usarNumeros) caracteresPermitidos += numeros;
                if (usarEspeciais) caracteresPermitidos += especiais;

                if (caracteresPermitidos.length === 0) {
                    senhaOutput.value = 'Selecione pelo menos um tipo';
                    return;
                }

                // Garantir que a senha contenha pelo menos um de cada tipo selecionado
                let senhaArray = [];
                const tiposSelecionados = [];
                if (usarMaiusculas) tiposSelecionados.push(maiusculas);
                if (usarMinusculas) tiposSelecionados.push(minusculas);
                if (usarNumeros) tiposSelecionados.push(numeros);
                if (usarEspeciais) tiposSelecionados.push(especiais);

                // Adicionar um caractere de cada tipo selecionado
                for (const tipo of tiposSelecionados) {
                    const indice = Math.floor(Math.random() * tipo.length);
                    senhaArray.push(tipo[indice]);
                }

                // Preencher o restante com caracteres aleatórios de todos os permitidos
                for (let i = senhaArray.length; i < tamanho; i++) {
                    const indice = Math.floor(Math.random() * caracteresPermitidos.length);
                    senhaArray.push(caracteresPermitidos[indice]);
                }

                // Embaralhar (Fisher-Yates)
                for (let i = senhaArray.length - 1; i > 0; i--) {
                    const j = Math.floor(Math.random() * (i + 1));
                    [senhaArray[i], senhaArray[j]] = [senhaArray[j], senhaArray[i]];
                }

                const senha = senhaArray.join('');
                senhaOutput.value = senha;
            }

            // Copiar para a área de transferência
            function copiarSenha() {
                const senha = senhaOutput.value;
                if (!senha || senha === 'Clique em gerar' || senha.includes('Selecione')) {
                    return;
                }

                if (navigator.clipboard && navigator.clipboard.writeText) {
                    navigator.clipboard.writeText(senha).then(() => {
                        mostrarToast('📋 Senha copiada!');
                        btnCopiar.classList.add('copiado');
                        setTimeout(() => btnCopiar.classList.remove('copiado'), 1500);
                    }).catch(() => {
                        // Fallback
                        copiarFallback(senha);
                    });
                } else {
                    copiarFallback(senha);
                }
            }

            function copiarFallback(texto) {
                const textarea = document.createElement('textarea');
                textarea.value = texto;
                textarea.style.position = 'fixed';
                textarea.style.opacity = '0';
                textarea.style.left = '-9999px';
                document.body.appendChild(textarea);
                textarea.select();
                try {
                    document.execCommand('copy');
                    mostrarToast('📋 Senha copiada!');
                    btnCopiar.classList.add('copiado');
                    setTimeout(() => btnCopiar.classList.remove('copiado'), 1500);
                } catch (e) {
                    mostrarToast('❌ Erro ao copiar');
                }
                document.body.removeChild(textarea);
            }

            // Toast
            let timeoutToast = null;
            function mostrarToast(mensagem) {
                toast.textContent = mensagem;
                toast.classList.add('show');
                clearTimeout(timeoutToast);
                timeoutToast = setTimeout(() => {
                    toast.classList.remove('show');
                }, 2000);
            }

            // Gerar ao carregar a página
            window.addEventListener('DOMContentLoaded', () => {
                gerarSenha();
            });

            // Eventos
            btnGerar.addEventListener('click', gerarSenha);
            btnCopiar.addEventListener('click', copiarSenha);

            // Atalho: Enter no campo de tamanho gera nova senha
            tamanhoInput.addEventListener('keydown', (e) => {
                if (e.key === 'Enter') {
                    e.preventDefault();
                    gerarSenha();
                }
            });

            // Qualquer alteração nos checkboxes ou range gera automaticamente (opcional)
            // Para melhor UX, deixamos o usuário clicar no botão, mas podemos adicionar:
            // document.querySelectorAll('.opcoes input, #tamanhoRange').forEach(el => {
            //     el.addEventListener('change', gerarSenha);
            // });
            // Por enquanto, mantemos somente no botão para evitar regeneração indesejada.
        })();
    </script>
</body>
</html>
